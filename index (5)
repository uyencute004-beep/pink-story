const focusNew=()=>openForm(null);
$('qaNew').onclick=focusNew;$('heroNew').onclick=focusNew;
$('backBtn').onclick=()=>go('home');
$('searchInput').oninput=e=>{q=e.target.value.trim().toLowerCase();if(view==='story')view='home';render()};

function render(){
  const u=sessionUser();if(!u)return;
  $('userName').textContent=u.username;$('avatar').textContent=u.username[0].toUpperCase();
  ['home','story','trash','form','read','char'].forEach(v=>$(v+'View').classList.toggle('hidden',v!==view));
  document.querySelectorAll('[data-nav]').forEach(a=>a.classList.toggle('on',a.dataset.nav===(view==='trash'?'trash':'home')));
  const all=mine(),trashN=all.filter(s=>s.deletedAt).length+all.filter(alive).reduce((n,s)=>n+s.parts.filter(p=>p.deletedAt).length,0);
  const b=$('trashBadge');b.textContent=trashN;b.classList.toggle('hidden',!trashN);updUsage();
  if(view==='home')renderHome(all,trashN);else if(view==='story')renderStory();else if(view==='form')renderDraft();else if(view==='read')renderRead();else if(view==='char')renderChar();else renderTrash(all);
}

