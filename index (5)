<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>🌸 Pink Story</title>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.min.js"></script>
<style>
*{box-sizing:border-box}
:root{--bg:#fdf6f8;--side:#fbeef2;--hero:#f6e4e8;--card:#fff;--line:#f1d5dd;--ac:#d4728d;--ac-d:#b5506d;--head:#8f3552;--tx:#3d2a31;--mu:#8c6a75;--dg:#c8434f}
body{margin:0;font-family:'Plus Jakarta Sans','Segoe UI',system-ui,sans-serif;background:var(--bg);color:var(--tx);min-height:100vh}
.hidden{display:none!important}
button{font:inherit;cursor:pointer;border:0;border-radius:999px;padding:10px 20px;font-weight:700;font-size:14px;background:var(--ac);color:#fff;transition:background .15s}
button:hover{background:var(--ac-d)}
button.ghost{background:#fff;color:var(--ac-d);border:1.5px solid var(--line)}
button.ghost:hover{background:var(--hero)}
button.danger{background:var(--dg)}
button.sm{padding:6px 14px;font-size:13px}
:focus-visible{outline:2px solid var(--ac-d);outline-offset:2px}
label{display:block;font-weight:700;font-size:13px;margin-bottom:6px}
input,textarea{width:100%;padding:11px 14px;border:1.5px solid var(--line);border-radius:14px;background:#fff;font:inherit;font-size:14px;margin-bottom:14px;color:var(--tx)}
input:focus,textarea:focus{outline:none;border-color:var(--ac)}
textarea{min-height:100px;resize:vertical}
h1,h2,h3{margin:0;color:var(--head)}
.mu{color:var(--mu);font-size:14px}
.err{color:var(--dg);font-size:14px;margin-top:8px}

/* auth */
#authView{min-height:100vh;display:grid;place-items:center;padding:20px;background:linear-gradient(135deg,#ffe3ec,#f6d3de)}
.auth{background:#fff;border-radius:28px;padding:36px;width:100%;max-width:400px;box-shadow:0 20px 50px rgba(181,80,109,.18)}
.auth h1{text-align:center;font-size:30px;margin-bottom:6px}
.auth form button{width:100%}
.auth .top{display:flex;justify-content:flex-end;margin-bottom:8px}

/* shell */
.shell{display:grid;grid-template-columns:270px 1fr;min-height:100vh}
aside{background:var(--side);border-right:1px solid var(--line);padding:22px 16px;position:sticky;top:0;height:100vh;display:flex;flex-direction:column;gap:22px}
.brand{display:flex;align-items:center;gap:12px;padding:0 6px}
.logo{width:46px;height:46px;border-radius:14px;background:var(--ac);display:grid;place-items:center;font-size:22px}
.brand b{display:block;font-size:17px;color:var(--tx)}
nav{display:flex;flex-direction:column;gap:6px}
nav a{display:flex;align-items:center;gap:12px;padding:13px 16px;border-radius:16px;color:var(--mu);font-weight:600;cursor:pointer;text-decoration:none}
nav a:hover{background:#fff7}
nav a.on{background:#fff;color:var(--ac-d);box-shadow:0 2px 8px rgba(181,80,109,.08)}
nav .badge{margin-left:auto;background:var(--ac);color:#fff;border-radius:999px;font-size:12px;padding:1px 9px}
.main{min-width:0}
.top{display:flex;align-items:center;gap:12px;padding:18px 32px;border-bottom:1px solid var(--line);flex-wrap:wrap}
.search{flex:1;min-width:200px;margin:0;border-radius:999px;padding:12px 20px}
.lang{display:flex;background:#fff;border:1.5px solid var(--line);border-radius:999px;padding:3px}
.lang button{background:none;color:var(--mu);padding:6px 14px;font-size:13px}
.lang button.on{background:var(--ac);color:#fff}
.user{font-size:14px;display:flex;align-items:center;gap:10px}
.avatar{width:34px;height:34px;border-radius:50%;background:var(--ac);color:#fff;display:grid;place-items:center;font-weight:800}
.page{padding:28px 32px 60px;max-width:1100px}
.hero{background:var(--hero);border:1px solid var(--line);border-radius:32px;padding:34px 38px;display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;margin-bottom:30px}
.hero h1{font-size:clamp(26px,4vw,42px);letter-spacing:-.02em;margin:6px 0 10px}
.hero p{margin:0;color:var(--mu);font-size:17px;max-width:520px;line-height:1.6}
.hero .kicker{font-weight:700;color:var(--ac-d);font-size:14px}
.sec{font-size:14px;font-weight:800;color:var(--mu);margin:0 0 14px}
.qa{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:16px;margin-bottom:34px}
.qa div{background:#fff;border:1.5px solid var(--line);border-radius:22px;padding:20px;cursor:pointer;font-weight:700;display:flex;flex-direction:column;gap:18px}
.qa div:hover{border-color:var(--ac)}
.ico{width:46px;height:46px;border-radius:14px;background:var(--hero);display:grid;place-items:center;font-size:20px}
.panel{background:#fff;border:1.5px solid var(--line);border-radius:28px;padding:26px;margin-bottom:26px}
.panel h2{font-size:21px;margin-bottom:16px;color:var(--tx)}
.row{border:1.5px solid var(--line);background:#fffafb;border-radius:20px;padding:16px 18px;margin-bottom:12px;display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap}
.row h3{font-size:17px;color:var(--tx);margin-bottom:4px}
.row p{margin:0}
.acts{display:flex;gap:8px;flex-wrap:wrap}
.tag{display:inline-block;background:var(--hero);color:var(--ac-d);border-radius:999px;padding:3px 12px;font-size:12px;font-weight:700;margin-right:6px}
.part-img{max-width:100%;border-radius:16px;margin:12px 0;display:block}
.part-content{white-space:pre-wrap;line-height:1.8;font-size:16px;font-family:Georgia,serif;margin-top:8px}
.part{border:1.5px solid var(--line);border-radius:22px;padding:20px;margin-bottom:16px;background:#fffafb}
.part .hd{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}
.back{margin-bottom:18px}
.toast{position:fixed;left:50%;bottom:26px;transform:translateX(-50%);background:var(--tx);color:#fff;padding:12px 20px;border-radius:999px;display:flex;gap:14px;align-items:center;font-size:14px;z-index:9;box-shadow:0 8px 24px #0003}
.toast button{background:none;color:#ffc2d1;padding:0;text-decoration:underline}
.trash-bar{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:18px}
.note{background:#fff4e5;border:1px solid #f5d9a8;color:#7a5410;border-radius:16px;padding:12px 16px;font-size:14px;margin-bottom:20px}
.thumb{width:72px;height:72px;border-radius:16px;object-fit:cover;flex:none}.thumb.ph{display:grid;place-items:center;background:var(--hero);font-size:28px}
.thumb.wide{width:100%;height:auto;max-height:200px}
.rw{display:flex;gap:14px;align-items:center;min-width:0;flex:1}
.clamp{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.av{width:44px;height:44px;border-radius:50%;object-fit:cover;flex:none}.av.ph{display:grid;place-items:center;background:var(--hero)}
.cover{border-radius:28px;min-height:260px;background:linear-gradient(135deg,#d99aae,#8f3552) center/cover;display:flex;align-items:flex-end;margin-bottom:20px;overflow:hidden}
.cover-in{width:100%;padding:28px;background:linear-gradient(transparent,#2b0f1acc);color:#fff}
.cover-in h1{color:#fff;font-size:clamp(26px,4vw,38px)}.cover-in p{margin:8px 0 12px;font-size:16px;opacity:.92}
.cover .tag{background:#ffffff26;color:#fff;border:1px solid #ffffff55}
.tabs{display:flex;border-bottom:1.5px solid var(--line);margin-bottom:20px}
.tabs button{background:none;color:var(--mu);border-radius:0;flex:1;padding:14px;border-bottom:3px solid transparent}
.tabs button:hover{background:none;color:var(--head)}.tabs button.on{color:var(--head);border-bottom-color:var(--ac)}
.kv{display:flex;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid var(--line);flex-wrap:wrap}
.char{display:flex;gap:12px;align-items:center;padding:8px 0}.char small{display:block;color:var(--mu);font-size:12px}
.bubble{display:flex;gap:14px;align-items:flex-start}.bubble .box{flex:1;min-width:0;border:1.5px solid var(--line);border-radius:22px;padding:16px 20px;background:#fffafb}
.fold{--fb:#fff;overflow:hidden}.box .fold{--fb:#fffafb}
.fold-in{max-height:240px;overflow:hidden;position:relative}.fold.open .fold-in{max-height:none}
.fold:not(.open) .fold-in::after{content:'';position:absolute;left:0;right:0;bottom:0;height:80px;background:linear-gradient(transparent,var(--fb))}
.fold p{margin:0 0 14px;line-height:1.75}.fold.short button{display:none}
.link{background:none;color:var(--ac-d);padding:6px 0;float:right}.link:hover{background:none;text-decoration:underline}
.cta{position:sticky;bottom:16px;width:100%;padding:16px;font-size:16px;box-shadow:0 8px 24px rgba(181,80,109,.35);z-index:5}
.npc-row{display:flex;gap:12px;align-items:flex-start;margin-bottom:14px}.grow{flex:1;min-width:0}.grow input{margin-bottom:8px}
.hint{font-size:13px;color:var(--mu);margin:-8px 0 12px}
.foot{margin-top:auto;display:flex;flex-direction:column;gap:8px}.bar{height:6px;background:#fff;border-radius:9px;overflow:hidden}.bar i{display:block;height:100%;background:var(--ac)}
.lbl{display:block;text-align:center;border:1.5px solid var(--line);border-radius:999px;padding:6px 14px;font-size:13px;font-weight:700;color:var(--ac-d);background:#fff;cursor:pointer}.lbl:hover{background:var(--hero)}
.rbar{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;margin-bottom:14px}
.rbox{border-radius:26px;padding:clamp(20px,5vw,44px);line-height:1.9;border:1.5px solid var(--line);min-height:50vh}
.rbox.light{background:#fff;color:var(--tx)}.rbox.sepia{background:#f4ecd8;color:#4b3b2a;border-color:#e3d6b8}.rbox.dark{background:#161b2e;color:#e6e8f0;border-color:#2a3150}
.rbox h2,.rbox h3{color:inherit}.rbox h2{font-size:1.3em;margin-bottom:4px}.rbox h3{font-size:1em;opacity:.7;margin-bottom:22px}.rbox p{margin:0 0 1.1em}.rbox img{max-width:100%;border-radius:14px;margin:0 0 1.2em}
.rnav{display:flex;gap:10px;margin-top:16px;align-items:center}.rnav select{flex:1;margin:0;min-width:0}
button:disabled{opacity:.4;cursor:default}
select{width:100%;padding:10px 12px;border:1.5px solid var(--line);border-radius:14px;background:#fff;font:inherit;font-size:14px;margin-bottom:14px;color:var(--tx)}
input[type=checkbox]{width:auto;margin:0 8px 0 0}.chk{display:flex;align-items:center;font-weight:600;margin-bottom:12px}
.fg{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:0 14px}
.rte{border:1.5px solid var(--line);border-radius:16px;background:#fff;margin-bottom:14px;overflow:hidden}
.rte .tb{display:flex;flex-wrap:wrap;gap:4px;padding:8px;background:var(--side);border-bottom:1px solid var(--line);align-items:center}
.rte .tb button{padding:4px 9px;font-size:13px;border-radius:8px;background:#fff;color:var(--tx);border:1px solid var(--line)}.rte .tb button:hover{background:var(--hero)}
.rte .tb select{width:auto;margin:0;padding:3px 6px;font-size:12px;border-radius:8px}
.rte .tb input[type=color]{width:28px;height:26px;padding:0;margin:0 2px;border-radius:6px;vertical-align:middle}
.rte .tb input.hex{width:78px;margin:0;padding:3px 6px;font-size:12px;border-radius:8px}
.rte .ed{min-height:130px;padding:14px 16px;line-height:1.7;outline:none;max-height:420px;overflow:auto}
.rte .ed:empty:before{content:attr(data-ph);color:var(--mu)}
.rich p,.rich div{margin:0 0 .7em}
.rhead{display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:14px 28px;background:#fff;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:9}
.rlogo{font-weight:800;font-size:21px;color:var(--head);cursor:pointer}
.rhead input{margin:0;flex:1;min-width:160px;border-radius:999px}.rhead select{margin:0;width:auto;border-radius:999px}
.rmain{max-width:1200px;margin:0 auto;padding:24px 28px 60px}.rmain h2{margin:6px 0 14px;font-size:22px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:18px;margin-bottom:34px}
.card{cursor:pointer;transition:transform .15s}.card:hover{transform:translateY(-4px)}
.card .im{aspect-ratio:3/4;border-radius:18px;background:var(--hero) center/cover;position:relative;overflow:hidden;display:grid;place-items:center;font-size:40px;box-shadow:0 6px 16px rgba(181,80,109,.15)}
.badge2{position:absolute;top:8px;left:8px;border-radius:999px;padding:2px 10px;font-size:11px;font-weight:800;color:#fff}.b-full{background:#2f9e6f}.b-on{background:var(--ac)}
.card h4{margin:8px 0 2px;font-size:14px;color:var(--tx);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.chip{cursor:pointer}.chip.on{background:var(--ac);color:#fff}
.dhead{display:flex;gap:24px;flex-wrap:wrap;margin-bottom:24px}.dhead .im{width:200px;aspect-ratio:3/4;border-radius:22px;background:var(--hero) center/cover;flex:none}
.page{max-width:1280px}
.rte .ed{min-height:300px;max-height:none;resize:vertical}#contentInput .ed{min-height:55vh}
.rte.fs{position:fixed;inset:0;z-index:60;border-radius:0;margin:0;display:flex;flex-direction:column;border:0}
.rte.fs .ed{flex:1;max-height:none;resize:none;font-size:18px;width:min(100%,920px);margin:0 auto}
#reader{background:var(--bg);color:var(--tx);min-height:100vh}
#reader.dk{--bg:#1c1420;--card:#2a1d2d;--line:#4a3450;--tx:#f6e7ef;--mu:#c8a8ba;--hero:#3b2842;--head:#ffb6cf;--side:#2a1d2d}
#reader .rhead{background:var(--card);border-color:var(--line);padding:12px 32px}
#reader .panel,#reader .row,#reader .lang,#reader select,#reader input{background:var(--card);color:var(--tx);border-color:var(--line)}
#reader .fold{--fb:var(--card)}
.rlogo b{color:var(--ac)}.rhead nav{display:flex;gap:4px;margin-left:18px}.rhead nav a{padding:9px 16px;border-radius:999px;font-weight:700;color:var(--mu);cursor:pointer}.rhead nav a:hover,.rhead nav a.on{background:var(--hero);color:var(--head)}
.rhead input#rSearch{display:none;flex:0 1 260px;min-width:120px}.rhead input#rSearch.show{display:block}
.icon{width:42px;height:42px;padding:0;border-radius:50%;background:var(--card);border:1.5px solid var(--ac);color:var(--tx);font-size:16px}.icon:hover{background:var(--hero)}
.rmain{max-width:1400px}
.hero3{position:relative;height:clamp(210px,34vw,400px);margin:8px 0 44px}
.hc{position:absolute;top:50%;transform:translate(-50%,-50%);border-radius:28px;background:linear-gradient(135deg,#f3b6c8,#c25b7e) center/cover;cursor:pointer;transition:all .4s;box-shadow:0 10px 30px rgba(143,53,82,.25);display:flex;align-items:flex-end;overflow:hidden}
.hc.o0{left:50%;width:52%;height:100%;z-index:2}.hc.o-1{left:21%;width:42%;height:80%;opacity:.8}.hc.o1{left:79%;width:42%;height:80%;opacity:.8}
.hct{padding:22px 26px;color:#fff}.hct h2{color:#fff;font-size:clamp(18px,3vw,32px);margin:6px 0}.hct p{margin:0;opacity:.92;font-size:15px}
.pills{display:flex;gap:12px;flex-wrap:wrap;margin:0 0 20px}
.pill{border-radius:999px;padding:10px 22px;background:var(--card);color:var(--tx);border:1.5px solid var(--line);font-weight:700;font-size:15px;width:auto;margin:0}
.pill:hover{background:var(--hero)}.pill.on,.pill.on:hover{background:var(--ac);color:#fff;border-color:var(--ac)}
.grid{grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:22px}
.rib{position:absolute;top:0;left:0;padding:6px 16px 7px 14px;border-radius:0 0 18px 0;font-weight:800;font-size:14px;color:#fff;background:#9b7aa8}.rib.full{background:var(--ac)}
@media(max-width:860px){.rhead nav{display:none}.hc.o-1,.hc.o1{display:none}.hc.o0{width:96%}.rhead,.rmain{padding-left:14px;padding-right:14px}.dhead .im{width:140px}.foot{margin:0 0 0 auto;flex-direction:row;align-items:center}.foot .mu,.foot .bar{display:none}
 .shell{grid-template-columns:1fr}
 aside{position:static;height:auto;flex-direction:row;align-items:center;padding:12px;overflow-x:auto}
 .brand div{display:none}
 nav{flex-direction:row}
 .top,.page{padding-left:16px;padding-right:16px}
 .hero{padding:24px}
}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>

<div id="reader" class="hidden">
  <header class="rhead"><span class="rlogo" onclick="rNav('home')">🌸 <b>Pink</b>Story</span>
    <nav><a data-n="hot" onclick="rNav('hot')" data-l="🔥 Truyện hot|🔥 Hot"></a><a data-n="lib" onclick="rNav('lib')" data-l="📚 Kho truyện|📚 Library"></a></nav>
    <span class="grow"></span>
    <input id="rSearch" data-lp="Tìm truyện...|Search stories..." /><button class="icon" id="rSearchBtn" title="Search">🔍</button><button class="icon" id="rTheme" title="Theme">🌙</button>
    <div class="lang" data-lang></div><button id="toStudio" data-l="✍️ Đăng nhập tác giả|✍️ Author login"></button></header>
  <main class="rmain" id="rMain"></main>
</div>
<div id="authView">
  <div class="auth">
    <div class="top"><button type="button" class="ghost sm" id="authBack" style="margin-right:auto" data-l="← Trang độc giả|← Reader site"></button><div class="lang" data-lang></div></div>
    <h1>🌸 Pink Story</h1>
    <p class="mu" style="text-align:center;margin:0 0 20px" data-i18n="tagline"></p>
    <form id="authForm">
      <label for="authUser" data-i18n="username"></label>
      <input type="email" id="authUser" required autocomplete="email" />
      <label for="authPass" data-i18n="password"></label>
      <input type="password" id="authPass" required minlength="6" autocomplete="current-password" />
      <button type="submit" id="authSubmit"></button>
      <p class="err" id="authError"></p>
    </form>
    <button type="button" class="ghost" id="googleBtn" style="width:100%;margin-bottom:12px" data-i18n="google"></button>
    <p style="text-align:center;margin:0 0 10px"><a href="#" id="forgot" class="mu" data-i18n="forgot"></a></p>
    <p class="mu" style="text-align:center"><span id="authToggleText"></span> <a href="#" id="authToggle" style="color:var(--ac-d);font-weight:700"></a></p>
  </div>
</div>

<div class="shell hidden" id="shell">
  <aside>
    <div class="brand"><div class="logo">📖</div><div><b>Pink Story</b><span class="mu" data-i18n="brandSub"></span></div></div>
    <nav>
      <a data-nav="home">🏠 <span data-i18n="navHome"></span></a>
      <a data-nav="trash">🗑️ <span data-i18n="navTrash"></span><span class="badge hidden" id="trashBadge"></span></a>
      <a id="toReaderNav">🌐 <span data-l="Trang độc giả|Reader site"></span></a>
    </nav>
    <div class="foot"><div class="mu" id="usage" style="font-size:12px"></div>
      <button class="ghost sm" id="exportBtn" data-i18n="export"></button>
      <label class="lbl" for="importFile" data-i18n="import"></label><input type="file" id="importFile" accept="application/json,.json" hidden></div>
  </aside>
  <div class="main">
    <div class="top">
      <input class="search" id="searchInput" data-ph="search" />
      <div class="lang" data-lang></div>
      <div class="user"><span class="avatar" id="avatar"></span><strong id="userName"></strong><button class="ghost sm" id="logoutBtn" data-i18n="logout"></button></div>
    </div>
    <div class="page">

      <section id="homeView">
        <div class="hero">
          <div>
            <div class="kicker" id="today"></div>
            <h1 id="welcome"></h1>
            <p id="summary"></p>
          </div>
          <button id="heroNew" data-i18n="newStory"></button>
        </div>
        <h2 class="sec" data-i18n="quick"></h2>
        <div class="qa">
          <div id="qaNew"><span class="ico">✨</span><span data-i18n="newStory"></span></div>
          <div id="qaTrash"><span class="ico">🗑️</span><span data-i18n="navTrash"></span></div>
        </div>
        <div class="panel"><h2 data-i18n="yourStories"></h2><div id="storyList"></div></div>
        
      </section>

      <section id="storyView" class="hidden">
        <button class="ghost sm back" id="backBtn" data-i18n="back"></button>
        <div id="storyBody"></div>
        <div class="panel" id="addPartPanel">
          <h2 id="partFormTitle"></h2>
          <form id="createPartForm">
            <label for="partNameInput" data-i18n="partName"></label>
            <input id="partNameInput" required />
            <label for="chapterNumInput" data-i18n="chapterNum"></label>
            <input type="number" id="chapterNumInput" min="1" />
            <label for="contentInput" data-i18n="content"></label>
            <div id="contentInput"></div>
