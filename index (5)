let toastTimer;
function toast(msg,undo){
  const el=$('toast');el.innerHTML=`<span>${msg}</span>`;
  if(undo){const b=document.createElement('button');b.textContent=t('undo');b.onclick=()=>{undo();el.classList.add('hidden')};el.appendChild(b)}
  el.classList.remove('hidden');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.add('hidden'),6000);
}
function delStory(id){mutate(m=>{m.find(s=>s.id===id).deletedAt=Date.now()});render();toast(t('movedStory'),()=>restoreStory(id,true))}
function delPart(id){mutate(m=>{const p=m.find(s=>s.id===currentStoryId).parts.find(p=>p.id===id);p.deletedAt=Date.now()});render();toast(t('movedPart'),()=>restorePart(currentStoryId,id,true))}
function restoreStory(id,quiet){mutate(m=>{delete m.find(s=>s.id===id).deletedAt});render();if(!quiet)toast(t('restored'))}
function restorePart(sid,pid,quiet){mutate(m=>{delete m.find(s=>s.id===sid).parts.find(p=>p.id===pid).deletedAt});render();if(!quiet)toast(t('restored'))}
function purgeStory(id){if(!confirm(t('confirmPurge')))return;mutate((m,all)=>{all.splice(all.findIndex(s=>s.id===id),1)});render();toast(t('purged'))}
function purgePart(sid,pid){if(!confirm(t('confirmPurge')))return;mutate(m=>{const s=m.find(s=>s.id===sid);s.parts=s.parts.filter(p=>p.id!==pid)});render();toast(t('purged'))}
$('emptyBtn').onclick=()=>{
  if(!confirm(t('confirmEmpty')))return;const u=sessionUser();
  mutate((m,all)=>{for(let i=all.length-1;i>=0;i--)if(all[i].userId===u.id&&all[i].deletedAt)all.splice(i,1);
    all.forEach(s=>{if(s.userId===u.id)s.parts=s.parts.filter(p=>!p.deletedAt)})});
  render();toast(t('purged'));
};
function renderTrash(all){
  const ds=all.filter(s=>s.deletedAt).sort((a,b)=>b.deletedAt-a.deletedAt);
  $('trashStories').innerHTML=!ds.length?`<p class="mu">${t('trashEmpty')}</p>`:ds.map(s=>`
   <div class="row"><div><h3>${esc(s.title)}</h3><p class="mu">${t('parts')(s.parts.length)} · ${t('deletedAt')}: ${fmt(s.deletedAt)}</p></div>
   <div class="acts"><button class="sm" onclick="restoreStory('${s.id}')">${t('restore')}</button><button class="danger sm" onclick="purgeStory('${s.id}')">${t('purge')}</button></div></div>`).join('');
  const dp=[];all.filter(alive).forEach(s=>s.parts.forEach(p=>p.deletedAt&&dp.push({s,p})));dp.sort((a,b)=>b.p.deletedAt-a.p.deletedAt);
  $('trashParts').innerHTML=!dp.length?`<p class="mu">${t('trashEmpty')}</p>`:dp.map(({s,p})=>`
   <div class="row"><div><h3>${p.chapterNumber?`${t('chapter')} ${p.chapterNumber} — `:''}${esc(p.partName)}</h3><p class="mu">${t('fromStory')}: ${esc(s.title)} · ${t('deletedAt')}: ${fmt(p.deletedAt)}</p></div>
   <div class="acts"><button class="sm" onclick="restorePart('${s.id}','${p.id}')">${t('restore')}</button><button class="danger sm" onclick="purgePart('${s.id}','${p.id}')">${t('purge')}</button></div></div>`).join('');
}

/* ---------- boot ---------- */
['fInfo','fOpen','fWorld','fTime','fNote','contentInput'].forEach(id=>mountRTE($(id)));
applyI18n();
if(configured){
  sb=window.supabase.createClient(SUPABASE_URL,SUPABASE_KEY);let last=null;
  const handle=async u=>{
    if(!u){cloudUser=null;uidNow=null;delete mem[KEY];synced={};enter();return}
    failWith(t('loading'));
    try{
      await loadCloud(u);cloudUser=u;await loadPubKeys(u);
      if(!load(KEY,[]).length&&!localStorage.getItem('ps_mig_'+u.id)){
        const old=await readLegacy();
        if(old.length&&confirm(t('migrate')(old.length))){old.forEach(x=>{x.userId=u.id;x.parts=x.parts||[]});save(KEY,old)}
        localStorage.setItem('ps_mig_'+u.id,'1')}
      failWith('');enter();syncQ=syncQ.then(()=>syncPub(pubSnapshot(load(KEY,[])))).catch(()=>{});
    }catch(e){failWith(t('loadFail')+' ('+(e.message||e.code)+')');sb.auth.signOut()}
  };
  sb.auth.onAuthStateChange((ev,session)=>{
    if(ev==='PASSWORD_RECOVERY')setTimeout(async()=>{const p=prompt(t('newPass'));if(p&&p.length>=6){const r=await sb.auth.updateUser({password:p});alert(r.error?r.error.message:t('passChanged'))}},300);
    const id=session?.user?.id||null;if(id===last)return;last=id;setTimeout(()=>handle(session?.user||null),0);
  });
}
enter();
</script>
