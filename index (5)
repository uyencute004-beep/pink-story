/* ---------- sanitizer + rich text ---------- */
const OK_TAGS=new Set(['B','STRONG','I','EM','U','S','STRIKE','SPAN','DIV','P','BR','UL','OL','LI','FONT']);
const OK_CSS=/^(color|background-color|font-size|font-family|text-align|line-height|letter-spacing|font-weight|font-style|text-decoration|text-decoration-line)$/;
const safeVal=v=>/^[#\w\s.,%'"()-]*$/.test(v)&&!/url|expression|javascript|import/i.test(v);
function clean(html){
  const doc=new DOMParser().parseFromString('<body>'+(html||''),'text/html'),box=document.createElement('div');
  const walk=(src,dst)=>src.childNodes.forEach(c=>{
    if(c.nodeType===3)dst.appendChild(document.createTextNode(c.nodeValue));
    else if(c.nodeType===1&&OK_TAGS.has(c.tagName)){
      const e=document.createElement(c.tagName==='FONT'?'span':c.tagName.toLowerCase()),st=c.style;
      for(let i=0;i<st.length;i++){const p=st[i],v=st.getPropertyValue(p);if(OK_CSS.test(p)&&safeVal(v))e.style.setProperty(p,v)}
      walk(c,e);dst.appendChild(e)
    }else if(c.nodeType===1&&!/^(SCRIPT|STYLE|IFRAME|OBJECT|EMBED|NOSCRIPT|TEMPLATE|SVG|MATH)$/i.test(c.tagName))walk(c,dst);
  });
  walk(doc.body,box);return box.innerHTML;
}
const isHtml=x=>/<(p|div|span|b|i|u|s|br|strong|em|ul|ol|li|font)[\s>\/]/i.test(x||'');
const rich=x=>!x?'':isHtml(x)?clean(x):para(x);
const rteGet=id=>{const h=$(id)._get();return h.replace(/<[^>]*>|&nbsp;/g,'').trim()?h:''};
const FONTS=['Georgia','Arial','Times New Roman','Courier New','Verdana','Tahoma','Comic Sans MS'],SZV=[12,14,16,18,20,24,28,32,40],LHV=[1.2,1.5,1.8,2,2.4],LSP=[0,0.5,1,2,3];
function mountRTE(box,html){
  const sel=(k,name,arr,fmt=x=>x)=>`<select data-s="${k}"><option value="">${name}</option>${arr.map(x=>`<option value="${x}">${fmt(x)}</option>`).join('')}</select>`;
  box.classList.add('rte');
  box.innerHTML=`<div class="tb"><button type="button" data-c="bold" title="Bold"><b>B</b></button><button type="button" data-c="italic" title="Italic"><i>I</i></button><button type="button" data-c="underline" title="Underline"><u>U</u></button><button type="button" data-c="strikeThrough" title="Strikethrough"><s>S</s></button>
   ${sel('font','Font',FONTS)}${sel('size','Size',SZV,x=>x+'px')}
   <span title="Text color">A<input type="color" data-col="foreColor" value="#000000"></span><input class="hex" data-hex="foreColor" placeholder="#HEX">
   <span title="Highlight">🖍<input type="color" data-col="hiliteColor" value="#ffe066"></span><input class="hex" data-hex="hiliteColor" placeholder="#HEX">
   <button type="button" data-c="justifyLeft" title="Left">⇤</button><button type="button" data-c="justifyCenter" title="Center">↔</button><button type="button" data-c="justifyRight" title="Right">⇥</button>
   ${sel('lh','↕ Line',LHV)}${sel('ls','↔ Letter',LSP,x=>x+'px')}<button type="button" data-r="1" title="Reset formatting">⌫ Reset</button><button type="button" data-fs="1" title="Fullscreen">⤢</button></div><div class="ed rich" contenteditable="true"></div>`;
  const ed=box.querySelector('.ed'),tb=box.querySelector('.tb');let saved=null;ed.innerHTML=rich(html||'');
  const keep=()=>{const g=getSelection();if(g.rangeCount&&ed.contains(g.anchorNode))saved=g.getRangeAt(0).cloneRange()};
  const restore=()=>{ed.focus();if(saved){const g=getSelection();g.removeAllRanges();g.addRange(saved)}};
  ['keyup','mouseup','input','blur'].forEach(ev=>ed.addEventListener(ev,keep));
  const exec=(c,v)=>{restore();document.execCommand('styleWithCSS',false,true);if(c==='hiliteColor'&&!document.execCommand('hiliteColor',false,v))document.execCommand('backColor',false,v);else if(c!=='hiliteColor')document.execCommand(c,false,v);keep()};
  const spanCss=css=>{restore();document.execCommand('styleWithCSS',false,true);document.execCommand('fontSize',false,'7');
    ed.querySelectorAll('span,font').forEach(sp=>{if(/xxx-large/.test(sp.style.fontSize)||sp.getAttribute('size')==='7'){sp.removeAttribute('size');sp.style.fontSize='';Object.assign(sp.style,css)}});keep()};
  const lineH=v=>{restore();document.execCommand('formatBlock',false,'div');keep();const r=saved;[...ed.children].forEach(ch=>{if(!r||r.intersectsNode(ch))ch.style.lineHeight=v})};
  const reset=()=>{restore();if(saved&&!saved.collapsed){document.execCommand('removeFormat');[...ed.children].forEach(ch=>{if(saved.intersectsNode(ch)){ch.style.lineHeight='';ch.style.textAlign=''}})}
    else if(confirm(lang==='vi'?'Xoá toàn bộ định dạng của ô này?':'Clear all formatting in this box?'))ed.innerHTML=rich(esc(ed.innerText))};
  tb.addEventListener('mousedown',e=>{if(e.target.closest('button'))e.preventDefault()});
  tb.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;if(b.dataset.c)exec(b.dataset.c);else if(b.dataset.r)reset();else if(b.dataset.fs){box.classList.toggle('fs');document.body.style.overflow=box.classList.contains('fs')?'hidden':'';ed.focus()}});
  tb.addEventListener('change',e=>{const k=e.target.dataset.s,v=e.target.value;if(!k||!v)return;
    if(k==='font')exec('fontName',v);else if(k==='size')spanCss({fontSize:v+'px'});else if(k==='ls')spanCss({letterSpacing:v+'px'});else if(k==='lh')lineH(v);e.target.value=''});
  tb.addEventListener('input',e=>{if(e.target.dataset.col)exec(e.target.dataset.col,e.target.value)});
  tb.addEventListener('keydown',e=>{if(e.key==='Enter'&&e.target.dataset.hex){e.preventDefault();const v=e.target.value.trim().replace(/^#?/,'#');if(/^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(v))exec(e.target.dataset.hex,v)}});
  ed.addEventListener('paste',e=>{e.preventDefault();const h=e.clipboardData.getData('text/html'),x=e.clipboardData.getData('text/plain');document.execCommand('insertHTML',false,h?clean(h):esc(x).replace(/\n/g,'<br>'))});
  box.addEventListener('keydown',e=>{if(e.key==='Escape'&&box.classList.contains('fs')){box.classList.remove('fs');document.body.style.overflow=''}});box._get=()=>clean(ed.innerHTML);box._set=h=>{ed.innerHTML=rich(h||'');saved=null};
}

/* ---------- characters (main / supporting / NPC) ---------- */
const L=(v,e)=>lang==='vi'?v:e;
