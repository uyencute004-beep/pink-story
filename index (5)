async function syncSnap(cur){
  const sets=[],dels=[];
  for(const k in cur)if(synced[k]!==cur[k].j)sets.push(k);
  for(const k in synced)if(!cur[k])dels.push(k);
  if(!sets.length&&!dels.length)return;setSync('saving');
  let batch=[],size=0;
  const flush=async()=>{if(!batch.length)return;
    const {error}=await sb.from('docs').upsert(batch.map(k=>({user_id:uidNow,key:k,data:JSON.parse(cur[k].j)})),{onConflict:'user_id,key'});
    if(error)throw error;batch.forEach(k=>synced[k]=cur[k].j);batch=[];size=0};
  for(const k of sets){if(batch.length&&size+cur[k].j.length>1500000)await flush();batch.push(k);size+=cur[k].j.length}
  await flush();
  for(let i=0;i<dels.length;i+=100){const c=dels.slice(i,i+100),{error}=await sb.from('docs').delete().eq('user_id',uidNow).in('key',c);
    if(error)throw error;c.forEach(k=>delete synced[k])}
  setSync('synced');
}
