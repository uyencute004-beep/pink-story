const fold=(id,txt)=>`<div class="fold" id="${id}"><div class="fold-in">${rich(txt)}</div><button class="link" onclick="toggleFold('${id}',this)">${t('more')}</button></div>`;
function toggleFold(id,b){const f=$(id);f.classList.toggle('open');b.textContent=t(f.classList.contains('open')?'less':'more')}
const avatar=a=>a?`<img class="av" src="${a}" alt="">`:'<span class="av ph">👤</span>';
function setTab(x){storyTab=x;render()}
function imgToURL(file,max,q=.82){return new Promise((res,rej)=>{if(!/^image\//.test(file.type))return rej();const im=new Image(),u=URL.createObjectURL(file);
  im.onload=()=>{const r=Math.min(1,max/Math.max(im.width,im.height)),c=document.createElement('canvas');c.width=im.width*r;c.height=im.height*r;const x=c.getContext('2d');x.fillStyle='#fff';x.fillRect(0,0,c.width,c.height);x.drawImage(im,0,0,c.width,c.height);URL.revokeObjectURL(u);res(c.toDataURL('image/jpeg',q))};
  im.onerror=rej;im.src=u})}

function renderStory(){
  const s=mine().find(x=>x.id===currentStoryId&&alive(x));if(!s)return go('home');
  const ps=s.parts.filter(p=>!p.deletedAt),mc=charsOf(s).find(c=>c.cat==='main')||{},info=infoOf(s);
  const chars=charsOf(s).map(c=>`<div class="char">${avatar(c.avatar)}<div><small>${L(CATS.find(x=>x[0]===c.cat)[1],CATS.find(x=>x[0]===c.cat)[2])}</small><b>${esc(c.name)}</b></div></div>`).join('');
  let h=`<div class="cover" style="${s.cover?`background-image:linear-gradient(#0000,#0000),url('${s.cover}')`:''}"><div class="cover-in"><h1>${esc(s.title)}</h1>${tagOf(s)?`<p>${esc(tagOf(s))}</p>`:''}
   <div><span class="tag">${stLabel(s)}</span>${(s.tags||[]).map(x=>`<span class="tag">${esc(x)}</span>`).join('')}</div><div class="acts" style="margin-top:14px"><button class="sm" onclick="togglePub('${s.id}')">${s.pub==='published'?'🚫 '+L('Gỡ xuất bản','Unpublish'):'🌐 '+L('Xuất bản','Publish')}</button><button class="sm" onclick="openRead('${s.id}')">📖 ${t('read')}</button><button class="ghost sm" onclick="openForm('${s.id}')">✏️ ${t('edit')}</button></div></div></div>
   <div class="tabs"><button class="${storyTab==='info'?'on':''}" onclick="setTab('info')">${t('tabInfo')}</button><button class="${storyTab==='parts'?'on':''}" onclick="setTab('parts')">${t('tabParts')} (${ps.length})</button><button class="${storyTab==='chars'?'on':''}" onclick="setTab('chars')">${L('Nhân vật','Characters')} (${charsOf(s).length})</button></div>`;
  if(storyTab==='info'){
    h+=`<div class="panel"><h2>${t('storyInfo')}</h2><div class="kv"><span class="mu">${t('storyName').replace(' *','')}</span><b>${esc(s.title)}</b></div>${chars}</div>`;
    if(s.opening)h+=`<div class="panel"><h2>${t('opening')}</h2><div class="bubble">${avatar(mc.avatar)}<div class="box">${fold('foldOpen',s.opening)}</div></div></div>`;
    if(info)h+=`<div class="panel"><h2>${t('pubInfo')}</h2>${fold('foldInfo',info)}</div>`;
    [['world','Bối cảnh & thế giới','World & setting'],['timeline','Mốc thời gian','Timeline'],['note','Ghi chú sáng tác','Writing notes']].forEach(([k,v,e])=>{if(s[k])h+=`<div class="panel"><h2>🔒 ${L(v,e)}</h2>${fold('fold_'+k,s[k])}</div>`});
    if(!s.opening&&!info&&!chars)h+=`<p class="mu">${t('emptyInfo')}</p>`;
  }else if(storyTab==='chars'){h+=charsPanel()}else h+=`<div class="panel"><div class="trash-bar"><h2 style="margin:0">${t('chapters')}</h2><button class="ghost sm" onclick="sortParts()">↕ ${t('sortNum')}</button></div>${!ps.length?`<p class="mu">${t('noParts')}</p>`:ps.map((p,i)=>`
   <div class="part"><div class="hd"><h3>${p.chapterNumber?`${t('chapter')} ${p.chapterNumber} — `:''}${esc(p.partName)}${p.draft?` <span class="tag">${L('Nháp','Draft')}</span>`:''}</h3>
   <div class="acts"><button class="ghost sm" ${i?'':'disabled'} onclick="moveP('${p.id}',-1)">↑</button><button class="ghost sm" ${i<ps.length-1?'':'disabled'} onclick="moveP('${p.id}',1)">↓</button><button class="ghost sm" onclick="startPart('${p.id}')">✏️</button><button class="danger sm" onclick="delPart('${p.id}')">${t('del')}</button></div></div>
   ${p.image?`<img class="part-img" src="${p.image}" alt="" />`:''}${p.content?fold('fp'+p.id,p.content):''}</div>`).join('')}</div>`;
  $('storyBody').innerHTML=h;if(storyTab==='chars')fillChars();$('addPartPanel').classList.toggle('hidden',storyTab!=='parts');renderPartForm();
  document.querySelectorAll('.fold').forEach(f=>{if(f.querySelector('.fold-in').scrollHeight<=245)f.classList.add('open','short')});
