let pubSynced={},pubKeys=new Set();
const authorName=()=>cloudUser?(cloudUser.user_metadata?.full_name||cloudUser.email.split('@')[0]):'';
async function loadPubKeys(u){pubKeys=new Set();pubSynced={};const r=await sb.from('public_docs').select('key').eq('user_id',u.id);if(!r.error)(r.data||[]).forEach(x=>pubKeys.add(x.key))}
function pubSnapshot(all){
  const m={};all.forEach(st=>{if(st.userId!==uidNow||st.deletedAt||st.pub!=='published')return;
    const ps=st.parts.filter(p=>!p.deletedAt&&!p.draft);
    const chs=charsOf(st).filter(c=>c.show!==false).map(({secret,note,custom,show,...c})=>c);
    m['s:'+st.id]=JSON.stringify({id:st.id,title:st.title,tagline:tagOf(st),tags:st.tags||[],cover:st.cover||null,progress:st.progress||'ongoing',featured:!!st.featured,hot:!!st.hot,author:authorName(),info:rich(infoOf(st)),opening:rich(st.opening||''),chars:chs,count:ps.length,last:ps.length?ps[ps.length-1].id:null});
    ps.forEach((p,i)=>{m['p:'+p.id]=JSON.stringify({id:p.id,storyId:st.id,title:p.partName,num:p.chapterNumber,content:rich(p.content||''),image:p.image||null,order:i})})});
  return m;
}
async function syncPub(cur){
  if(!uidNow)return;const sets=[],dels=[];
  for(const k in cur)if(pubSynced[k]!==cur[k])sets.push(k);
  for(const k of pubKeys)if(!cur[k])dels.push(k);
  if(!sets.length&&!dels.length)return;setSync('saving');
  let batch=[],size=0;
  const flush=async()=>{if(!batch.length)return;
    const {error}=await sb.from('public_docs').upsert(batch.map(k=>({user_id:uidNow,key:k,data:JSON.parse(cur[k]),updated_at:new Date().toISOString()})),{onConflict:'user_id,key'});
    if(error)throw new Error(L('Chưa tạo bảng public_docs: ','public_docs table missing: ')+error.message);batch.forEach(k=>{pubSynced[k]=cur[k];pubKeys.add(k)});batch=[];size=0};
  for(const k of sets){if(batch.length&&size+cur[k].length>1500000)await flush();batch.push(k);size+=cur[k].length}
  await flush();
  for(let i=0;i<dels.length;i+=100){const c=dels.slice(i,i+100),{error}=await sb.from('public_docs').delete().eq('user_id',uidNow).in('key',c);if(error)throw error;c.forEach(k=>{pubKeys.delete(k);delete pubSynced[k]})}
  setSync('synced');
}

