  const list=live.filter(s=>!q||(s.title+' '+tagOf(s)+' '+(s.tags||[]).join(' ')).toLowerCase().includes(q));
  $('storyList').innerHTML=!live.length?`<p class="mu">${t('noStories')}</p>`:!list.length?`<p class="mu">${t('noMatch')}</p>`:list.map(s=>`
   <div class="row"><div class="rw">${s.cover?`<img class="thumb" src="${s.cover}" alt="">`:'<span class="thumb ph">📖</span>'}<div style="min-width:0"><h3>${esc(s.title)}</h3><p class="mu clamp">${esc(tagOf(s)||infoOf(s)||t('noDesc'))}</p>
